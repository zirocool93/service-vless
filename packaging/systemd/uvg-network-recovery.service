[Unit]
Description=Восстановление исходной сети Ubuntu VPN Gateway
After=network-pre.target nftables.service
Before=ubuntu-vpn-gateway.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/lib/ubuntu-vpn-gateway/uvg-watchdog recover
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ubuntu-vpn-gateway
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
